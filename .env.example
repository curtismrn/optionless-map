# Optional. Enables the SATELLITE style (MapTiler "satellite" raster tiles).
# MapTiler keys are browser-exposed by design: restrict the key to your domains
# in the MapTiler dashboard. Never put secret/server keys in NEXT_PUBLIC_ vars.
NEXT_PUBLIC_MAPTILER_KEY=

# Optional. Self-hosted OSRM for road-following suggestions (default: public demo server).
NEXT_PUBLIC_OSRM_URL=
