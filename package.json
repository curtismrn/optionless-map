{
  "name": "optionless-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OPTIONLESS MAP — community-built atlas of automotive roads.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "data:fetch": "node scripts/fetch-routes.mjs",
    "data:media": "node scripts/fetch-media.mjs && node scripts/curate-media.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "invite": "node scripts/invite.mjs",
    "test:shared": "node scripts/e2e-shared.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "db:seed": "node scripts/db-setup.mjs --seed",
    "dev:demo": "node scripts/dev-demo.mjs",
    "test:members": "node scripts/test-members.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.59.0",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^6.15.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "opentype.js": "^2.0.0",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
